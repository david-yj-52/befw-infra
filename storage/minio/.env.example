# MinIO 오브젝트 스토리지 설정
# cp .env.example .env 후 값 채우기

# ── 인증 ────────────────────────────────────────────────
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin

# ── 포트 ─────────────────────────────────────────────────
# API (S3 호환): 앱 서버 MINIO_ENDPOINT 와 맞춰야 함
MINIO_API_PORT=9000
# 관리 콘솔 Web UI
MINIO_CONSOLE_PORT=9001
# 외부 공개 여부 (기본 127.0.0.1 = 호스트 내부만). 외부 공개 시 0.0.0.0
MINIO_API_BIND=127.0.0.1

# ── 네트워크 ─────────────────────────────────────────────
# 앱 서버와 같은 Docker 네트워크 이름
CLOUD_NETWORK_NAME=befw-cloud-network

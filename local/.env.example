# =============================================
# TSH Local 통합 개발환경 설정
# cp .env.example .env 후 실제 값 입력
# =============================================

# --- PostgreSQL ---
POSTGRES_USER=postgres
POSTGRES_PASSWORD=tsh_super_1234!
POSTGRES_DB=tsh_dev
APP_DB_USER=tsh_app
APP_DB_PASSWORD=tsh_app_1234!
POSTGRES_PORT=5432

# --- Kafka ---
KAFKA_ADVERTISED_HOST=localhost
KAFKA_PORT=9092
KAFKA_UI_PORT=8989

# --- Solace ---
SOLACE_ADMIN_PASSWORD=tsh_solace_1234!
SOLACE_SMF_PORT=55555
SOLACE_MQTT_PORT=1883
SOLACE_AMQP_PORT=5672
SOLACE_REST_PORT=9000
SOLACE_MGMT_PORT=8080

# --- Nexus ---
NEXUS_PORT=8081

# --- Spring Cloud (local only) ---
CONFIG_USER=config-user
CONFIG_PASSWORD=config-pass
# 기본값 native는 옆에 체크아웃된 Config 저장소 파일을 직접 읽음
CONFIG_SERVER_PROFILE=native
# CONFIG_SERVER_PROFILE을 비워 Git backend로 쓸 때 아래 설정 사용
CONFIG_GIT_URI=https://github.com/david-yj-52/befw-infra-cloud-cofing-repo
CONFIG_GIT_LABEL=main
# 비공개 Config 저장소일 때만 입력하고, 실제 값은 .env에만 저장
GIT_USERNAME=
GIT_TOKEN=
CLOUD_CONFIG_PORT=8888
CLOUD_EUREKA_PORT=8761
CLOUD_GATEWAY_PORT=10001
CLOUD_CONFIG_IMAGE=ghcr.io/david-yj-52/befw-infra-cloud-config:latest
CLOUD_EUREKA_IMAGE=ghcr.io/david-yj-52/befw-infra-cloud-eureka:latest
CLOUD_GATEWAY_IMAGE=ghcr.io/david-yj-52/befw-infra-cloud-gateway:latest

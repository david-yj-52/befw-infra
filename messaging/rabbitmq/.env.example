# =============================================
# RabbitMQ Configuration
# cp .env.example .env 후 실제 값 입력
# =============================================

RABBITMQ_DEFAULT_USER=admin
RABBITMQ_DEFAULT_PASS=your_admin_password_here
RABBITMQ_DEFAULT_VHOST=/

# 포트
RABBITMQ_AMQP_PORT=5672     # AMQP 프로토콜 (애플리케이션에서 연결)
RABBITMQ_MGMT_PORT=15672    # 관리 Web UI
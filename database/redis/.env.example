# =============================================
# Redis Configuration
# cp .env.example .env 후 실제 값 입력
# =============================================

REDIS_PASSWORD=your_admin_password_here
REDIS_DEFAULT_DIR=./data

# 포트
REDIS_TCP_PORT=5672     # AMQP 프로토콜 (애플리케이션에서 연결)
REDIS_MGMT_PORT=15672    # 관리 Web UI
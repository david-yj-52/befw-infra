# Config Server local container settings
CONFIG_USER=config-user
CONFIG_PASSWORD=config-pass
CONFIG_SERVER_PROFILE=native

# Local image published to GHCR by the cloud-config repository workflow
CLOUD_CONFIG_IMAGE=ghcr.io/david-yj-52/befw-infra-cloud-config:latest
CLOUD_CONFIG_PORT=8888

# Only needed if switching CONFIG_SERVER_PROFILE away from native to Git backend
CONFIG_GIT_URI=https://github.com/david-yj-52/befw-infra-cloud-cofing-repo
CONFIG_GIT_LABEL=main
GIT_USERNAME=
GIT_TOKEN=

# Copy this file to .env, then run service Compose files with:
# docker compose --env-file ..\.env pull
# docker compose --env-file ..\.env up -d
# Create the shared network once before starting an individual service:
# docker network create befw-cloud-network

# Config Server authentication (local development only)
CONFIG_USER=config-user
CONFIG_PASSWORD=config-pass

# Config Server repository; native reads the sibling checkout mounted by Compose.
CONFIG_SERVER_PROFILE=native
CONFIG_GIT_URI=https://github.com/david-yj-52/befw-infra-cloud-cofing-repo
CONFIG_GIT_LABEL=main
GIT_USERNAME=
GIT_TOKEN=

# Host ports
CLOUD_CONFIG_PORT=8888
CLOUD_EUREKA_PORT=8761
CLOUD_GATEWAY_PORT=10001

# GHCR images; replace latest with a version tag or sha-... tag to pin a build
CLOUD_CONFIG_IMAGE=ghcr.io/david-yj-52/befw-infra-cloud-config:latest
CLOUD_EUREKA_IMAGE=ghcr.io/david-yj-52/befw-infra-cloud-eureka:latest
CLOUD_GATEWAY_IMAGE=ghcr.io/david-yj-52/befw-infra-cloud-gateway:latest

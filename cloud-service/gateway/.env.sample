# Must match CONFIG_USER and CONFIG_PASSWORD used by the running Config Server.
CONFIG_USER=config-user
CONFIG_PASSWORD=config-pass

# GHCR image and host port
CLOUD_GATEWAY_IMAGE=ghcr.io/david-yj-52/befw-infra-cloud-gateway:latest
CLOUD_GATEWAY_PORT=10001

# Local development only. For real JWT validation, use the same secret as the backend.
JWT_SECRET=local-dev-only-replace-with-the-same-secret-used-by-backend-12345
